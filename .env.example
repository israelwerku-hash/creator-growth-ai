# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Database (Prisma) ──────────────────────────────────────
DATABASE_URL=

# ─── Upstash QStash ─────────────────────────────────────────
# Get these from your Upstash Console: https://console.upstash.com/qstash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ─── Upstash Redis ──────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Groq AI ────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ─── Sentry ─────────────────────────────────────────────────
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── Whop Webhooks & API ─────────────────────────────────────
WHOP_WEBHOOK_SECRET=
WHOP_API_KEY=

# ─── Whop Subscription Plan IDs ─────────────────────────────
NEXT_PUBLIC_WHOP_PRO_MONTHLY_PLAN_ID=
NEXT_PUBLIC_WHOP_PRO_ANNUAL_PLAN_ID=
NEXT_PUBLIC_WHOP_AGENCY_MONTHLY_PLAN_ID=
NEXT_PUBLIC_WHOP_AGENCY_ANNUAL_PLAN_ID=

# ─── Whop Top-Up Plan IDs ───────────────────────────────────
NEXT_PUBLIC_WHOP_TOPUP_STARTER_PLAN_ID=
NEXT_PUBLIC_WHOP_TOPUP_GROWTH_PLAN_ID=
NEXT_PUBLIC_WHOP_TOPUP_ELITE_PLAN_ID=

# ─── Admin Override (Server-Side Only) ──────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Turnstile (Cloudflare CAPTCHA) ─────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
